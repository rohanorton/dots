[include]
    path = ~/.config/git/aliases
    path = ~/.config/git/personal

[includeIf "gitdir:~/Code/itacs/"]
    path = ~/.config/git/itacs

[init]
    defaultBranch = main

[rebase]
    autosquash = true
    autostash = true

[fetch]
    prune = true

[push]
    autoSetupRemote = true

[diff]
    colorMoved = default

[merge]
    conflictstyle = zdiff3

[rerere]
    enabled = true

[core]
    editor = nvim

[commit]
    verbose = true

