{
  "title": "ISO Section Key to Hash",
  "rules": [
    {
      "description": "Change section to hash",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "non_us_backslash" },
          "to": [{ "key_code": "3", "modifiers": ["left_option"] }]
        }
      ]
    }
  ]
}
